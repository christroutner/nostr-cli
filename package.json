{
  "name": "nostr-cli",
  "version": "1.0.0",
  "description": "CLI for interacting with Nostr relays",
  "main": "nostr-cli.js",
  "type": "module",
  "bin": {
    "nostr-cli": "./nostr-cli.js"
  },
  "scripts": {
    "start": "node nostr-cli.js",
    "test": "c8 --reporter=text mocha --recursive test/unit/ --timeout 5000",
    "lint": "standard"
  },
  "keywords": [
    "nostr",
    "cli",
    "relay",
    "nostr-tools"
  ],
  "license": "MIT",
  "standard": {
    "env": ["mocha"]
  },
  "dependencies": {
    "@noble/hashes": "^1.3.0",
    "cli-table": "^0.3.11",
    "commander": "^12.1.0",
    "nostr": "^0.2.8",
    "nostr-tools": "^2.7.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "c8": "^8.0.0",
    "chai": "^5.1.0",
    "mocha": "^10.2.0",
    "sinon": "^17.0.0",
    "standard": "^17.0.0"
  }
}
